# ===========================================
# SPOTCIN Backend — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores
# ===========================================

# JWT
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio

# Postgres
# Em Docker: host = nome do serviço (postgres), porta interna 5432
# Em local:  host = localhost, porta mapeada 5432
DATABASE_URL=postgres://spotcin:spotcin@postgres:5432/spotcin?sslmode=disable

# Redis
# Em Docker: redis:6379
# Em local:  localhost:6379
REDIS_ADDR=redis:6379

# Garage (S3-compatível)
GARAGE_ENDPOINT=http://garage:3900
GARAGE_ACCESS_KEY=minioadmin
GARAGE_SECRET_KEY=minioadminminioadmin
GARAGE_BUCKET=spotcin-audio